.atl/
.claude/
*Zone.Identifier
__pycache__/
node_modules/
publish/
.cf-token
disenos/*BACKUP*/

# Cleartext access keys for the visor gate (salt+hash live in the tracked gate-keys.json; the
# shareable cleartext keys must never be committed). Written by keygen.mjs.
gate-secret.txt

# per-session worktree claims — never tracked (a tracked claim keeps stale HEAD content)
.session-claim.txt
.session-claim.local

# per-worktree handoff note — never tracked (collides on every merge; belongs to ONE worktree)
RESUME.md

# P7 offline single-file build output — a generated MIRROR of the modular src/ (build-offline.mjs).
# Never tracked: it is regenerated every build and is not a source of truth.
disenos/*/dist/
