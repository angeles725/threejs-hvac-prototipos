<p id="mwHQ">Eurocontainers are based around two standard heights of <style data-mw-deduplicate="TemplateStyles:r1154941027" typeof="mw:Extension/templatestyles mw:Transclusion" about="#mwt25" id="mwHg" data-mw='{"name":"templatestyles","attrs":{"src":"Fraction/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"convert","href":"./Template:Convert"},"params":{"1":{"wt":"147.5"},"2":{"wt":"mm"},"3":{"wt":"in"},"abbr":{"wt":"on"},"frac":{"wt":"8"}},"i":0}}]}'>.mw-parser-output .frac{white-space:nowrap}.mw-parser-output .frac .num,.mw-parser-output .frac .den{font-size:80%;line-height:0;vertical-align:super}.mw-parser-output .frac .den{vertical-align:sub}.mw-parser-output .sr-only{border:0;clip:rect(0,0,0,0);clip-path:polygon(0px 0px,0px 0px,0px 0px);height:1px;margin:-1px;overflow:hidden;padding:0;position:absolute;width:1px}</style><span about="#mwt25">147.5</span><span typeof="mw:Entity" about="#mwt25"> </span><span about="#mwt25">mm (</span><span class="frac" about="#mwt25">5<span class="sr-only">+</span><span class="num">3</span><span typeof="mw:Entity">⁄</span><span class="den">4</span></span><span typeof="mw:Entity" about="#mwt25"> </span><span about="#mwt25">in)</span> and <span about="#mwt27" typeof="mw:Transclusion" id="mwHw" data-mw='{"parts":[{"template":{"target":{"wt":"convert","href":"./Template:Convert"},"params":{"1":{"wt":"280"},"2":{"wt":"mm"},"3":{"wt":"in"},"abbr":{"wt":"on"},"frac":{"wt":"8"}},"i":0}}]}'>280</span><span typeof="mw:Entity" about="#mwt27"> </span><span about="#mwt27">mm (11</span><span typeof="mw:Entity" about="#mwt27"> </span><span about="#mwt27">in)</span>, including a <link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1154941027" about="#mwt28" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwIA" data-mw='{"name":"templatestyles","attrs":{"src":"Fraction/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"convert","href":"./Template:Convert"},"params":{"1":{"wt