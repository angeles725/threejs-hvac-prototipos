        4: ['tl', 'mid', 'tr', 'br'],
        5: ['top', 'tl', 'mid', 'br', 'bottom'],
        6: ['top', 'tl', 'mid', 'bl', 'br', 'bottom'],
        7: ['top', 'tr', 'br'],
